# Copy this file to ".env" (same folder) and fill in your key.
# NEVER commit your real .env file. The app works without it; only AI buttons need it.

# "anthropic" (Claude) or "openai" (OpenAI or any OpenAI-compatible server)
LLM_PROVIDER=anthropic

# Your secret API key
LLM_API_KEY=

# Optional: model name. Defaults: anthropic -> claude-opus-5-5, openai -> gpt-4o-mini
LLM_MODEL=

# Optional, only for OpenAI-compatible servers, e.g.
#   Groq:   https://api.groq.com/openai/v1
#   Ollama: http://localhost:11434/v1
LLM_BASE_URL=
