# AI settings for AutomataAI. Copy this file to ".env" (same folder) and fill in your key.
# NEVER commit your real .env file (it is in .gitignore). The app works without it;
# only the AI buttons need it.
#
# Choose ONE provider (both are free, no credit card):
#   gemini     https://aistudio.google.com/apikey   (default)
#   groq       https://console.groq.com/keys        (good backup if Gemini is busy)
# Advanced: "openai" works with OpenAI itself or any OpenAI-compatible server
# (e.g. Ollama on your own computer) together with LLM_BASE_URL below.
LLM_PROVIDER=gemini

# Paste your secret API key after the = sign (no quotes, no spaces)
LLM_API_KEY=

# Optional: a different model. Defaults: gemini-3.8-flash (gemini),
# llama-3.3-70b-versatile (groq), gpt-4o-mini (openai)
LLM_MODEL=

# Optional: only for other OpenAI-compatible servers, e.g. Ollama: http://localhost:11434/v1
LLM_BASE_URL=
