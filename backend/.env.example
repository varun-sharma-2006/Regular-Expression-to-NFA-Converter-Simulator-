# AI settings for AutomataAI. Copy this file to ".env" (same folder) and fill in your key.
# NEVER commit your real .env file (it is in .gitignore). The app works without it;
# only the AI buttons need it.
#
# Choose ONE provider:
#   gemini     FREE key: https://aistudio.google.com/apikey
#   groq       FREE key: https://console.groq.com/keys
#   anthropic  Claude (paid): https://console.anthropic.com/
#   openai     OpenAI (paid), or any OpenAI-compatible server with LLM_BASE_URL
LLM_PROVIDER=gemini

# Paste your secret API key after the = sign (no quotes, no spaces)
LLM_API_KEY=

# Optional: a different model. Defaults: gemini-3.8-flash, llama-3.3-70b-versatile,
# claude-opus-5-5, gpt-4o-mini
LLM_MODEL=

# Optional: only for other OpenAI-compatible servers, e.g. Ollama: http://localhost:11434/v1
LLM_BASE_URL=
